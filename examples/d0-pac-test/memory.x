MEMORY
{
  PSRAM_TEXT : ORIGIN = 0x50100000, LENGTH = 512K
  PSRAM_DATA : ORIGIN = 0x50180000, LENGTH = 512K
}

REGION_ALIAS("REGION_TEXT",   PSRAM_TEXT);
REGION_ALIAS("REGION_RODATA", PSRAM_TEXT);
REGION_ALIAS("REGION_DATA",   PSRAM_DATA);
REGION_ALIAS("REGION_BSS",    PSRAM_DATA);
REGION_ALIAS("REGION_HEAP",   PSRAM_DATA);
REGION_ALIAS("REGION_STACK",  PSRAM_DATA);

_stack_start = ORIGIN(PSRAM_DATA) + LENGTH(PSRAM_DATA);
