    <register>
      <name>VDO_H264_FRAME_SIZE</name>
      <description>Main-stream frame resolution (in pixels)</description>
      <addressOffset>0x004</addressOffset>
      <fields>
        <field>
          <name>cfg_frame_width</name>
          <description>Frame width in pixels</description>
          <bitOffset>0</bitOffset>
          <bitWidth>11</bitWidth>
        </field>
        <field>
          <name>cfg_frame_height</name>
          <description>Frame height in pixels</description>
          <bitOffset>16</bitOffset>
          <bitWidth>11</bitWidth>
        </field>
      </fields>
    </register>

    <!-- ============================================================ -->
    <!-- 0x008 : vdo_h264_frame_base_addr_y                           -->
