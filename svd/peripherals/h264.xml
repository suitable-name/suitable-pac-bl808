          <bitOffset>23</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_ctrl_mode</name>
          <description>Controller mode (0=DVP, 1=SW, 2=auto)</description>
          <bitOffset>24</bitOffset>
          <bitWidth>2</bitWidth>
        </field>
        <field>
          <name>cfg_cref_en</name>
          <description>Main-stream cross-reference enable</description>
          <bitOffset>26</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_s_cref_en</name>
          <description>Secondary-stream cross-reference enable</description>
          <bitOffset>27</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_frame_start</name>
          <description>Main-stream frame start trigger (SW mode)</description>
          <bitOffset>28</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_enc_seq_en</name>
          <description>Main-stream encoder sequence enable</description>
          <bitOffset>29</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_s_frame_start</name>
          <description>Secondary-stream frame start trigger (SW mode)</description>
          <bitOffset>30</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_s_enc_seq_en</name>
          <description>Secondary-stream encoder sequence enable</description>
          <bitOffset>31</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
      </fields>
    </register>

    <!-- ============================================================ -->
    <!-- 0x004 : vdo_h264_frame_size  (main stream)                   -->
