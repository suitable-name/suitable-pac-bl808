      <addressOffset>0x000</addressOffset>
      <fields>
        <field>
          <name>cfg_enc_ctrl_mby_idx</name>
          <description>Current MB row index (debug)</description>
          <bitOffset>0</bitOffset>
          <bitWidth>7</bitWidth>
          <access>read-only</access>
        </field>
        <field>
          <name>cfg_core_clk_en</name>
          <description>Core clock enable</description>
          <bitOffset>8</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_zstuf_dis</name>
          <description>Disable zero-stuffing</description>
          <bitOffset>9</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_qr_upd</name>
          <description>Main-stream QP update trigger</description>
          <bitOffset>10</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_s_qr_upd</name>
          <description>Secondary-stream QP update trigger</description>
          <bitOffset>11</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_mem_clk_en</name>
          <description>Memory clock enable</description>
          <bitOffset>12</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_rc_gop_upd</name>
          <description>Main-stream rate-control GOP update trigger</description>
          <bitOffset>13</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_s_rc_gop_upd</name>
          <description>Secondary-stream rate-control GOP update trigger</description>
          <bitOffset>14</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_duo_bs_en</name>
          <description>Dual bitstream (main+secondary) enable</description>
          <bitOffset>15</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_buf_clr</name>
          <description>Main-stream buffer clear</description>
          <bitOffset>16</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_s_buf_clr</name>
          <description>Secondary-stream buffer clear</description>
          <bitOffset>17</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_vdonr_en</name>
          <description>Main-stream 3D-NR enable</description>
          <bitOffset>18</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_s_vdonr_en</name>
          <description>Secondary-stream 3D-NR enable</description>
          <bitOffset>19</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cfg_bs_status_init</name>
