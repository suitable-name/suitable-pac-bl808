<peripheral>
  <name>H264</name>
  <description>H.264 Video Encoder (VENC) — VIDEO_BASE 0x30022000</description>
  <groupName>H264</groupName>
  <baseAddress>0x30022000</baseAddress>
  <addressBlock>
    <offset>0</offset>
    <size>0x1000</size>
    <usage>registers</usage>
  </addressBlock>

  <!-- ================================================================================== -->
  <!-- GLOBAL PROPERTIES                                                                   -->
  <!-- ================================================================================== -->
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>

  <!-- D0-CPU interrupt numbers (IRQ_NUM_BASE = 16) -->
  <interrupt>
    <name>H264_BS</name>
    <description>H264 main-stream bitstream interrupt (H264_BS_IRQn = IRQ_NUM_BASE+17)</description>
    <value>33</value>
  </interrupt>
  <interrupt>
    <name>H264_FRAME</name>
    <description>H264 main-stream frame-done interrupt (H264_FRAME_IRQn = IRQ_NUM_BASE+18)</description>
    <value>34</value>
  </interrupt>
  <interrupt>
    <name>H264_SEQ_DONE</name>
    <description>H264 main-stream sequence-done interrupt (H264_SEQ_DONE_IRQn = IRQ_NUM_BASE+19)</description>
    <value>35</value>
  </interrupt>
  <interrupt>
    <name>H264_S_BS</name>
    <description>H264 secondary-stream bitstream interrupt (H264_S_BS_IRQn = IRQ_NUM_BASE+21)</description>
    <value>37</value>
  </interrupt>
  <interrupt>
    <name>H264_S_FRAME</name>
    <description>H264 secondary-stream frame-done interrupt (H264_S_FRAME_IRQn = IRQ_NUM_BASE+22)</description>
    <value>38</value>
  </interrupt>
  <interrupt>
    <name>H264_S_SEQ_DONE</name>
    <description>H264 secondary-stream sequence-done interrupt (H264_S_SEQ_DONE_IRQn = IRQ_NUM_BASE+23)</description>
    <value>39</value>
  </interrupt>

  <registers>
    <!-- ============================================================ -->
    <!-- 0x000 : vdo_h264_encoder_ctrl                                -->
    <!-- ============================================================ -->
