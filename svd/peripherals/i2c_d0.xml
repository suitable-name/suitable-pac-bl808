          <description>I2C Master function enable</description>
          <bitOffset>0</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cr_i2c_pkt_dir</name>
          <description>Packet transfer direction. 0: Write, 1: Read</description>
          <bitOffset>1</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cr_i2c_deg_en</name>
          <description>Enable de-glitch function</description>
          <bitOffset>2</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cr_i2c_scl_sync_en</name>
          <description>Enable SCL synchronization (Clock stretching support)</description>
          <bitOffset>3</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cr_i2c_sub_addr_en</name>
          <description>Enable sub-address field</description>
          <bitOffset>4</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
          <name>cr_i2c_sub_addr_bc</name>
          <description>Sub-address byte count (0-3: 1-4 bytes)</description>
          <bitOffset>5</bitOffset>
          <bitWidth>2</bitWidth>
        </field>
        <field>
          <name>cr_i2c_10b_addr_en</name>
          <description>Enable 10-bit address mode</description>
          <bitOffset>7</bitOffset>
          <bitWidth>1</bitWidth>
        </field>
        <field>
