        <field>
          <name>cr_i2c_pkt_len</name>
          <description>Packet length in bytes</description>
          <bitOffset>20</bitOffset>
          <bitWidth>8</bitWidth>
        </field>
        <field>
          <name>cr_i2c_deg_cnt</name>
