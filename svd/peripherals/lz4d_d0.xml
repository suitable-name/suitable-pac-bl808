<peripheral>
    <name>LZ4D</name>
    <description>Hardware LZ4 Decompressor</description>
    <groupName>LZ4D</groupName>
    <baseAddress>0x2000AD00</baseAddress>
    <addressBlock>
        <offset>0</offset>
        <size>0x100</size>
        <usage>registers</usage>
    </addressBlock>

    
    
    
    <size>32</size>
    <access>read-write</access>
    <resetValue>0x00000000</resetValue>
    <resetMask>0xFFFFFFFF</resetMask>

    <registers>
        <register>
            <name>LZ4_CONFIG</name>
            <description>LZ4 Configuration Register</description>
            <addressOffset>0x00</addressOffset>
            <fields>
                <field>
                    <name>lz4_en</name>
                    <description>Enable LZ4 decompression</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>1</bitWidth>
                </field>
                <field>
                    <name>lz4_suspend</name>
                    <description>Suspend LZ4 decompression</description>
                    <bitOffset>1</bitOffset>
                    <bitWidth>1</bitWidth>
                </field>
                <field>
                    <name>lz4_checksum</name>
                    <description>Enable LZ4 checksum verification</description>
                    <bitOffset>4</bitOffset>
                    <bitWidth>1</bitWidth>
                </field>
            </fields>
        </register>

        <register>
            <name>LZ4_SRC_FIX</name>
            <description>Source Address Fix Configuration</description>
            <addressOffset>0x04</addressOffset>
            <fields>
                <field>
                    <name>lz4_src_fix</name>
                    <bitOffset>12</bitOffset>
                    <bitWidth>14</bitWidth>
                </field>
            </fields>
        </register>

        <register>
            <name>LZ4_DST_FIX</name>
            <description>Destination Address Fix Configuration</description>
            <addressOffset>0x08</addressOffset>
            <fields>
                <field>
                    <name>lz4_dst_fix</name>
                    <bitOffset>12</bitOffset>
                    <bitWidth>14</bitWidth>
                </field>
            </fields>
        </register>

        <register>
            <name>LZ4_SRC_START</name>
            <description>Source Start Address</description>
            <addressOffset>0x10</addressOffset>
            <fields>
                <field>
                    <name>lz4_src_start</name>
                    <description>Source start offset address</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>26</bitWidth>
                </field>
                <field>
                    <name>lz4_src_base</name>
                    <description>Source base address pointer</description>
                    <bitOffset>26</bitOffset>
                    <bitWidth>6</bitWidth>
                </field>
            </fields>
        </register>

        <register>
            <name>LZ4_SRC_END</name>
            <description>Source End Address Status</description>
            <addressOffset>0x14</addressOffset>
            <access>read-only</access>
            <fields>
                <field>
                    <name>lz4_src_end</name>
                    <description>Final source address after decompression</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>26</bitWidth>
                </field>
            </fields>
        </register>

        <register>
            <name>LZ4_DST_START</name>
            <description>Destination Start Address</description>
            <addressOffset>0x18</addressOffset>
            <fields>
                <field>
                    <name>lz4_dst_start</name>
                    <description>Destination start offset address</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>26</bitWidth>
                </field>
                <field>
                    <name>lz4_dst_base</name>
                    <description>Destination base address pointer</description>
                    <bitOffset>26</bitOffset>
                    <bitWidth>6</bitWidth>
                </field>
            </fields>
        </register>

        <register>
            <name>LZ4_DST_END</name>
            <description>Destination End Address Status</description>
            <addressOffset>0x1C</addressOffset>
            <access>read-only</access>
            <fields>
                <field>
                    <name>lz4_dst_end</name>
                    <description>Final destination address after decompression</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>26</bitWidth>
                </field>
            </fields>
        </register>

        <register>
            <name>LZ4_INT_EN</name>
            <description>LZ4 Interrupt Enable Register</description>
            <addressOffset>0x20</addressOffset>
            <resetValue>0x00000003</resetValue>
            <fields>
                <field>
                    <name>lz4_done_en</name>
                    <description>Enable decompression done interrupt</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>1</bitWidth>
                </field>
                <field>
                    <name>lz4_err_en</name>
                    <description>Enable decompression error interrupt</description>
                    <bitOffset>1</bitOffset>
                    <bitWidth>1</bitWidth>
                </field>
                <field>
                    <name>lz4_dst_int_en</name>
                    <description>Destination-specific interrupt enables</description>
                    <bitOffset>10</bitOffset>
                    <bitWidth>6</bitWidth>
                </field>
                <field>
                    <name>lz4_dst_int_inv</name>
                    <description>Destination-specific interrupt inversion</description>
                    <bitOffset>26</bitOffset>
                    <bitWidth>6</bitWidth>
                </field>
            </fields>
        </register>

        <register>
            <name>LZ4_INT_STA</name>
            <description>LZ4 Interrupt Status Register</description>
            <addressOffset>0x24</addressOffset>
            <access>read-only</access>
            <fields>
                <field>
                    <name>lz4_done_sta</name>
                    <description>Decompression done status</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>1</bitWidth>
                </field>
                <field>
                    <name>lz4_err_sta</name>
                    <description>Decompression error status</description>
                    <bitOffset>1</bitOffset>
                    <bitWidth>1</bitWidth>
                </field>
                <field>
                    <name>lz4_dst_int_sta</name>
                    <description>Destination-specific interrupt status</description>
                    <bitOffset>10</bitOffset>
                    <bitWidth>6</bitWidth>
                </field>
            </fields>
        </register>

        <register>
            <name>LZ4_MONITOR</name>
            <description>LZ4 Engine Monitor Register</description>
            <addressOffset>0x28</addressOffset>
            <access>read-only</access>
            <fields>
                <field>
                    <name>lz4_cs</name>
                    <description>LZ4 Control State monitor</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>4</bitWidth>
                </field>
            </fields>
        </register>
    </registers>
</peripheral>