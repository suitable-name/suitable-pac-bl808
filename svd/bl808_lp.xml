<device schemaVersion="1.3"
    xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd"
    xmlns:xi="http://www.w3.org/2001/XInclude">
    <name>BL808_LP</name>
    <version>1.4</version>
    <description>Bouffalo Lab BL808 Low-Power Subsystem (LP Core)</description>
    <cpu>
        <name>LP</name>
        <revision>r0p1</revision>
        <endian>little</endian>
        <mpuPresent>false</mpuPresent>
        <fpuPresent>false</fpuPresent>
        <nvicPrioBits>4</nvicPrioBits>
        <vendorSystickConfig>false</vendorSystickConfig>
    </cpu>
    <addressUnitBits>8</addressUnitBits>
    <width>32</width>

    <peripherals>
        <!-- Include base definitions (Base files now contain their own interrupts) -->
        <xi:include href="peripherals/hbn.xml" />
        <xi:include href="peripherals/aon.xml" />
        <xi:include href="peripherals/pds.xml" />
        <xi:include href="peripherals/glb.xml" />
        <xi:include href="peripherals/ipc.xml" />
        <peripheral derivedFrom="IPC">
            <name>IPC1</name>
            <baseAddress>0x2000A840</baseAddress>
        </peripheral>
        <xi:include href="peripherals/ir.xml" />
        <xi:include href="peripherals/audio.xml" />
        <xi:include href="peripherals/lz4d.xml" />
        <xi:include href="peripherals/timer.xml" />
        <xi:include href="peripherals/pwm.xml" />
        <xi:include href="peripherals/i2c.xml" />
        <peripheral derivedFrom="I2C0">
            <name>I2C1</name>
            <baseAddress>0x2000A900</baseAddress>
            <interrupt>
                <name>I2C1</name>
                <value>55</value>
            </interrupt>
        </peripheral>
        <xi:include href="peripherals/sec_eng.xml" />
        <xi:include href="peripherals/sf_ctrl.xml" />
        <xi:include href="peripherals/gpip.xml" />
        <xi:include href="peripherals/dma.xml" />
        <peripheral derivedFrom="DMA0">
            <name>DMA1</name>
            <baseAddress>0x20071000</baseAddress>
            <interrupt>
                <name>DMA1_ALL</name>
                <value>32</value>
            </interrupt>
        </peripheral>
        <xi:include href="peripherals/sdh.xml" />
        <xi:include href="peripherals/usb.xml" />
        <xi:include href="peripherals/emac.xml" />
        <xi:include href="peripherals/efuse.xml" />
        <xi:include href="peripherals/spi.xml" />
        <xi:include href="peripherals/uart.xml" />
        <peripheral derivedFrom="UART0">
            <name>UART1</name>
            <baseAddress>0x2000A100</baseAddress>
            <interrupt>
                <name>UART1</name>
                <value>45</value>
            </interrupt>
        </peripheral>
        <peripheral derivedFrom="UART0">
            <name>UART2</name>
            <baseAddress>0x2000AA00</baseAddress>
            <interrupt>
                <name>UART2</name>
                <value>46</value>
            </interrupt>
        </peripheral>
    </peripherals>
</device>